# Claude (https://console.anthropic.com) - or run `ant auth login` instead
ANTHROPIC_API_KEY=
# Google Lens + Shopping search (https://serpapi.com, free tier = 250 searches/mo; each piece uses 2)
SERPAPI_API_KEY=
# Shared secret the iOS Shortcut sends as the X-App-Token header. Make up a long random string.
APP_TOKEN=
# Your public https URL (from cloudflared/ngrok or your host). Google Lens fetches the crops from here.
PUBLIC_BASE_URL=
COUNTRY=us
BUDGET_PRICE=50
LOOK_TTL_MIN=60
# 1 = Claude fast mode (~2.5x faster output, 2x token price)
FAST_MODE=1
